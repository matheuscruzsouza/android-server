<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#16161A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="#2C2C2E"
    app:strokeColor="#2C2C2E"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Topo: Avatar + Nome + Login + Badge de Política -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar com Inicial -->
            <TextView
                android:id="@+id/tvUserAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#242429"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="U"
                android:textColor="#0A84FF"
                android:textSize="17sp" />

            <!-- Nome e Access Key -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="Nome do Usuário"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvUserHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="@usuario"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Badge da Política IAM -->
            <TextView
                android:id="@+id/tvUserPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#242429"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Admin"
                android:textColor="#0A84FF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Barra de Status de Credencial / Token de 1º Acesso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#202026"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvUserSecret"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="Token 1º acesso: ------"
                android:textColor="#30D158"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rodapé com Botões de Ação Bem Distribuídos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfigUser"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Ver Detalhes &amp; Arquivos"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#0A84FF"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteUser"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="88dp"
                android:text="Excluir"
                android:textAllCaps="false"
                android:textColor="#FF453A"
                android:textSize="12sp"
                app:backgroundTint="#242429"
                app:cornerRadius="10dp"
                app:strokeColor="#3A2022"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
